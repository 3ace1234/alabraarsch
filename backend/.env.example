# ---------------------------------------------------------------------------
# Al-Falaah School Portal API — environment template
# Copy this file to `.env` and replace every placeholder before deploying.
# ---------------------------------------------------------------------------
APP_NAME="Al-Falaah School Portal"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://portal.example.edu.ng
APP_TIMEZONE=Africa/Lagos
APP_KEY=replace-with-64-random-hex-characters
API_VERSION=1

# Application database account (least privilege: SELECT/INSERT/UPDATE/DELETE)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=alfalaah_portal
DB_USERNAME=alfalaah_app
DB_PASSWORD=replace-with-a-strong-database-password
DB_CHARSET=utf8mb4
DB_TIMEZONE=+01:00

# Only used by scripts/install.php to create the database and app user.
# Remove these two lines after installation if you prefer.
DB_ADMIN_USERNAME=root
DB_ADMIN_PASSWORD=

# Browser session
SESSION_NAME=alfalaah_portal_session
SESSION_LIFETIME=120
SESSION_SECURE=true
SESSION_SAMESITE=Lax

# Comma-separated origins allowed to call the API with credentials.
# For same-origin XAMPP use: http://localhost,http://127.0.0.1
# For local Vite/Live Server add the exact ports you use, e.g.
# http://localhost:5173,http://127.0.0.1:5500
CORS_ALLOWED_ORIGINS=https://portal.example.edu.ng

# Password used by `php scripts/install.php --fresh` for demo accounts.
# Change it immediately after the first login. Demo seeding is disabled in
# production unless this value is explicitly set.
DEMO_PASSWORD=replace-with-a-demo-password
