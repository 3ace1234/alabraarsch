# ---------------------------------------------------------------------------
# Al-Falaah School Portal API — environment template
# Copy this file to `.env` and replace every placeholder before deploying.
# ---------------------------------------------------------------------------
APP_NAME="Al-Falaah School Portal"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://portal.example.edu.ng
APP_TIMEZONE=Africa/Lagos
APP_KEY=replace-with-64-random-hex-characters
API_VERSION=1

# Application database account (least privilege: SELECT/INSERT/UPDATE/DELETE)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=alfalaah_portal
DB_USERNAME=alfalaah_app
DB_PASSWORD=replace-with-a-strong-database-password
DB_CHARSET=utf8mb4
DB_TIMEZONE=+01:00

# Only used by scripts/install.php and scripts/migrate.php to create or alter
# the database. Remove these two lines after setup if you prefer.
DB_ADMIN_USERNAME=root
DB_ADMIN_PASSWORD=

# Browser session
SESSION_NAME=alfalaah_portal_session
SESSION_LIFETIME=120
SESSION_SECURE=true
SESSION_SAMESITE=Lax

# Comma-separated origins allowed to call the API with credentials.
# For same-origin XAMPP use: http://localhost,http://127.0.0.1
# For local Vite/Live Server add the exact ports you use, e.g.
# http://localhost:5173,http://127.0.0.1:5500
CORS_ALLOWED_ORIGINS=https://portal.example.edu.ng

# Email notifications for website admission and contact submissions.
# Drivers: smtp, mail, log (write storage/logs/mail.log) or none.
# Encryption: tls (STARTTLS, usually port 587), ssl (implicit TLS, usually 465)
# or none. MAIL_INTAKE_TO is the fallback recipient for both forms.
MAIL_DRIVER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@alfalaah.edu.ng
MAIL_FROM_NAME="Al-Falaah School"
MAIL_ADMISSIONS_TO=admissions@alfalaah.edu.ng
MAIL_CONTACT_TO=info@alfalaah.edu.ng
MAIL_INTAKE_TO=
MAIL_TIMEOUT=10

# Public URL of the frontend, used for deep links in notification emails.
# Leave blank to omit links from the email body.
PORTAL_URL=https://portal.example.edu.ng

# Password used by `php scripts/install.php --fresh` for demo accounts.
# Change it immediately after the first login. Demo seeding is disabled in
# production unless this value is explicitly set.
DEMO_PASSWORD=replace-with-a-demo-password
